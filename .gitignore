############################################
# 0) 기본: 전부 무시
############################################
*

############################################
# 1) 디렉터리 탐색 허용(중요)
############################################
!*/

############################################
# 2) 레포/CI에 필요한 파일/폴더 허용
############################################
!.gitignore
!.gitattributes
!README.md

!.github/
!.github/**          # ← 폴더 안의 모든 파일까지 허용

############################################
# 3) 소스/정적파일 허용(확장자)
############################################
!*.php
!*.js
!*.css
!*.json
!*.ini
!*.html
!*.htm
!*.map
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.ico
!*.webp
!*.woff
!*.woff2
!*.ttf
!*.eot
!*.otf

# 프로젝트 스크립트/설정도 허용 (필요 시)
!*.md
!*.sql
!*.sh
!*.bat
!*.ps1
!*.yml
!*.yaml
!*.code-workspace
!.editorconfig

############################################
# 4) 서버 설정 파일(배포 루트 www/만 허용)
############################################
!www/.htaccess
!www/.user.ini
!www/php.ini

############################################
# 5) 빈 폴더 보존용
############################################
!.gitkeep
!www/.gitkeep
!www/jtech/.gitkeep
!www/mywork/.gitkeep
!www/game/.gitkeep
!www/os/.gitkeep

############################################
# 6) (빌드용) 패키지 매니저 파일이 www에 있다면 허용
############################################
!www/package.json
!www/package-lock.json
!www/pnpm-lock.yaml
!www/yarn.lock

############################################
# 7) 반드시 무시(화이트리스트보다 우선: 아래쪽에 둠)
############################################
# 민감/환경
.env
.env.*
*.pem
*.key
*.crt
*.p12

# OS/IDE/캐시
.DS_Store
Thumbs.db
.vscode/
.claude/
.cursor/
.idea/
.history/
.cache/

# 빌드/의존성/런타임
node_modules/
# vendor/            # 서버에서 composer 못 돌리면 이 줄 제거하고, Actions에서 빌드 후 업로드
dist/
build/
coverage/
*.log

# 업로드/스토리지
uploads/
storage/

# 기타
lib/
_mirror_*.git/
common/
dbeditor/
PHPExcel_1.8.0/
tcpdf/
components/